# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example IS committed, real secrets never are
.env*.local
.env

# vercel
.vercel

# local assignments store (file driver) — guest data, never commit it
/data

# typescript
*.tsbuildinfo
next-env.d.ts

# anthem clips are committed on purpose — keep them out of any ignore rule
!/public/anthems/*.mp3
